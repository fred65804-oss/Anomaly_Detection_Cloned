{
  "use_autoencoder": true,
  "use_pca_features": true,
  "anomaly_detectors": [
    "isolation_forest",
    "lof"
  ],
  "supervised_weight": 0.1,
  "ensemble_method": "max",
  "optimize_weights": false,
  "ae_encoding_dim": 32,
  "ae_epochs": 20,
  "ae_batch_size": 256,
  "ae_dropout": 0.2,
  "iso_n_estimators": 300,
  "iso_max_samples": 256,
