  "iso_max_features": 0.7,
  "lof_n_neighbors": 10,
  "lof_contamination": 0.3,
  "rf_n_estimators": 100,
  "rf_max_depth": 20,
  "rf_min_samples_split": 20,
  "rf_min_samples_leaf": 10,
  "rf_max_features": "sqrt",
  "rf_class_weight": "balanced",
  "pca_n_components": 0.95,
  "correlation_threshold": 0.95,
  "threshold_min": 0.2,
  "threshold_max": 0.8,
  "threshold_step": 0.01,
  "default_threshold": 0.5,
  "weight_min": 0.1,
  "weight_max": 0.7,
  "weight_step": 0.05
